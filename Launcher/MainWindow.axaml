<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Width="700"
        Height="420"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        x:Class="Launcher.MainWindow"
        Title="SISTEMA INSIDE-TECH">

    <Border
        CornerRadius="14"
        BorderBrush="#7B2CBF"
        BorderThickness="1.5"
        ClipToBounds="True">

        <Border.Background>
            <LinearGradientBrush
                StartPoint="0%,0%"
                EndPoint="100%,100%">

                <GradientStop
                    Color="#3C096C"
                    Offset="0.0" />

                <GradientStop
                    Color="#240046"
                    Offset="0.5" />

                <GradientStop
                    Color="#10002B"
                    Offset="1.0" />

            </LinearGradientBrush>
        </Border.Background>

        <Grid
            x:Name="TitleBar"
            RowDefinitions="Auto,*,Auto">

            <Button
                x:Name="FecharBotao"
                Grid.Row="0"
                Content="✕"
                Width="34"
                Height="34"
                HorizontalAlignment="Right"
                Margin="0,12,14,0"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="Transparent"
                Foreground="#E0AAFF"
                FontSize="15"
                FontWeight="Bold"
                CornerRadius="17"
                BorderThickness="0"/>

            <StackPanel
                Grid.Row="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="20">

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="18">

                    <Image
                        x:Name="ImagemLoading"
                        Source="avares://Launcher/Assets/logoAplicativo.png"
                        Width="68"
                        Height="68"
                        VerticalAlignment="Center"/>

                    <StackPanel
                        VerticalAlignment="Center"
                        Spacing="3">

                        <TextBlock
                            Text="Sistema Inside-Tech"
                            Foreground="White"
                            FontSize="28"
                            FontWeight="Bold"
                            LetterSpacing="2"/>

                        <TextBlock
                            Text="TECNOLOGIA • IA • SISTEMAS"
                            Foreground="#E0AAFF"
                            FontSize="13"
                            FontWeight="SemiBold"
                            LetterSpacing="3"/>

                    </StackPanel>

                </StackPanel>

                <Border
                    Width="380"
                    Height="22"
                    Background="#10002B"
                    BorderBrush="#7B2CBF"
                    BorderThickness="1.5"
                    CornerRadius="5"
                    Padding="2"
                    ClipToBounds="True">

                    <StackPanel
                        x:Name="LoadingBar"
                        Orientation="Horizontal"
                        Spacing="2"
                        HorizontalAlignment="Left">

                        <StackPanel.RenderTransform>
                            <TranslateTransform X="-40"/>
                        </StackPanel.RenderTransform>

                        <Border
                            Width="12"
                            Height="14"
                            Background="#C77DFF"
                            CornerRadius="1"/>

                        <Border
                            Width="12"
                            Height="14"
                            Background="#9D4EDD"
                            CornerRadius="1"/>

                        <Border
                            Width="12"
                            Height="14"
                            Background="#7B2CBF"
                            CornerRadius="1"/>

                        <Border
                            Width="12"
                            Height="14"
                            Background="#C77DFF"
                            CornerRadius="1"/>

                        <Border
                            Width="12"
                            Height="14"
                            Background="#9D4EDD"
                            CornerRadius="1"/>

                        <Border
                            Width="12"
                            Height="14"
                            Background="#7B2CBF"
                            CornerRadius="1"/>

                    </StackPanel>

                </Border>


                <TextBlock
                    x:Name="TxtStatus"
                    Text="Iniciando Sistema..."
                    Foreground="#E0AAFF"
                    FontSize="14"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="520"/>

                <Button
                    x:Name="BtnTentarNovamente"
                    Content="Tentar Novamente"
                    IsVisible="False"
                    HorizontalAlignment="Center"
                    Margin="0,6,0,0"
                    Padding="14,8"
                    Background="#7B2CBF"
                    Foreground="White"
                    FontSize="13"
                    CornerRadius="6"
                    BorderBrush="#C77DFF"
                    BorderThickness="1"/>

            </StackPanel>

            <Grid
                Grid.Row="2"
                Margin="25,0,25,18"
                ColumnDefinitions="*,Auto">

                <TextBlock
                    Grid.Column="0"
                    Text="Insidetech © 2026"
                    FontSize="11"
                    Foreground="#9D4EDD"
                    VerticalAlignment="Center"/>

                <TextBlock
                    Grid.Column="1"
                    Text="v1.0"
                    FontSize="11"
                    Foreground="#9D4EDD"
                    VerticalAlignment="Center"/>

            </Grid>

        </Grid>

    </Border>

</Window>